# Copy to .env.local and fill in. Anything left empty is hidden on the site.

# Public site details
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=        # digits only, with country code, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CITY=

# AI chatbot (Claude). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5         # optional override, e.g. claude-haiku-5-5 for lower cost

# Gmail automation for "Book a call" (Google account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
BOOKING_NOTIFY_EMAIL=                # where new bookings go; defaults to GMAIL_USER

# WhatsApp automation via WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=                  # your team's number, digits only
WHATSAPP_TEMPLATE=                   # approved template name with one body variable (recommended)
WHATSAPP_TEMPLATE_LANG=en

# Business details shown in the footer and policies (optional)
NEXT_PUBLIC_BUSINESS_ADDRESS=
